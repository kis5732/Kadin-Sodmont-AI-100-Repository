# ------------------------------------------------------------
# STEP 2: Import Libraries
# ------------------------------------------------------------

import pandas as pd
import numpy as np

from sklearn.model_selection import train_test_split
from sklearn.linear_model import LogisticRegression

from sklearn.metrics import (
    accuracy_score,
    confusion_matrix,
    classification_report
)

# ------------------------------------------------------------
# STEP 3: Load the Kaggle Dataset
# ------------------------------------------------------------

file_path = "/content/drive/MyDrive/datasets/Heart Disease.csv"

df = pd.read_csv(file_path)

print("Dataset loaded successfully!")
print("Number of rows:", len(df))
print("Number of columns:", len(df.columns))

# ------------------------------------------------------------
# STEP 4: Look at the Dataset
# ------------------------------------------------------------

print(df.head())

print(df.columns)

# ------------------------------------------------------------
# STEP 5: Understand the Dataset
# ------------------------------------------------------------

print(df.info())

print(df.describe())

"""We want to predict:

Heart Disease

0 = Did not get Heart Disease
1 = Did get Heart Disease

Age
Blood Pressure
Heart Rate
Exercise Hours
Stress Level
Blood Sugar


"""

# ------------------------------------------------------------
# STEP 6: Select Features and Target
# ------------------------------------------------------------

Features = [
    "Age",
    "Blood Pressure",
    "Heart Rate",
    "Exercise Hours",
    "Stress Level",
    "Blood Sugar"
]

X = df[Features]

y = df["Heart Disease"]

print("Features:")
print(X.head())

print("\nTarget:")
print(y.head())

# ------------------------------------------------------------
# STEP 7: Check for Missing Values
# ------------------------------------------------------------

print(X.isnull().sum())

# ------------------------------------------------------------
# STEP 8: Handle Missing Values
# ------------------------------------------------------------

X = X.copy()

X["Age"] = X["Age"].fillna(X["Age"].median())

print("Missing values after cleaning:")
print(X.isnull().sum())

# ------------------------------------------------------------
# STEP 9: Split Data into Training and Testing Sets
# ------------------------------------------------------------

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42
)

print("Training data:", len(X_train))
print("Testing data:", len(X_test))

# ------------------------------------------------------------
# STEP 10: Create Logistic Regression Model
# ------------------------------------------------------------

model = LogisticRegression(max_iter=1000)

print(model)

# ------------------------------------------------------------
# STEP 11: Train the Model
# ------------------------------------------------------------

model.fit(X_train, y_train)

print("Model training completed!")

"""fit() is where the machine learning happens.
 The model looks at
 Features + Known Answers
        ↓
   Learn patterns
        ↓
   Logistic Model
"""

# ------------------------------------------------------------
# STEP 12: Make Predictions
# ------------------------------------------------------------

y_pred = model.predict(X_test)

print("Predictions:")
print(y_pred[:20])

"""The predictions will be
0
1
0
1
1
0
... where 0 = Did Not Get Heart Disease
1 = Did Get Heart Disease
"""

# ------------------------------------------------------------
# STEP 13: Calculate Accuracy
# ------------------------------------------------------------

accuracy = accuracy_score(y_test, y_pred)

print("Accuracy:", accuracy)

print("Accuracy percentage:", accuracy * 100, "%")

# ------------------------------------------------------------
# STEP 14: Confusion Matrix
# ------------------------------------------------------------

cm = confusion_matrix(y_test, y_pred)

print("Confusion Matrix:")
print(cm)

"""                 ACTUAL
              0          1

PREDICT  0   Correct    Wrong
         1   Wrong      Correct
"""

# ------------------------------------------------------------
# STEP 15: Classification Report
# ------------------------------------------------------------

print(classification_report(y_test, y_pred))

# ------------------------------------------------------------
# STEP 16: Predict Probabilities
# ------------------------------------------------------------

probabilities = model.predict_proba(X_test)

print(probabilities[:10])

Heart_Disease = pd.DataFrame({
    "Age": [25],
    "Blood Pressure": [25],
    "Heart Rate": [84],
    "Exercise Hours": [4],
    "Stress Level": [100],
    "Blood Sugar": [100]
})

prediction = model.predict(Heart_Disease)

probability = model.predict_proba(Heart_Disease)

print("Prediction:", prediction)

print("Heart Disease:",
      probability[0][0])

print("Heart Disease:",
      probability[0][1])

# ------------------------------------------------------------
# STEP 18: Human-Friendly Prediction
# ------------------------------------------------------------

if prediction[0] == 1:
    print("The model predicts: Did Not Get Heard Disease")
else:
    print("The model predicts: Got Heart Disease")

import pandas as pd

# ------------------------------------------------------------
# STEP 19: Examine Model Coefficients
# ------------------------------------------------------------

coefficients = pd.DataFrame({
    "Feature": X_train.columns,
    "Coefficient": model.coef_[0]
})

print(coefficients)
